{
  "name": "dsh-local-llm-controller",
  "version": "1.0.6",
  "description": "DSH plugin: start/stop a local llama.cpp llama-server (Qwen3.6-35B / Qwen3.5-9B, vision/text × fast/long-context) from the settings → plugins page, and keep the DSH provider contextWindow in sync.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "setting-plug.png",
    "setting-model.png",
    "useing.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lbunc/dsh-local-llm-controller.git"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "cordis",
    "llama.cpp",
    "llama-server",
    "local-llm",
    "qwen"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.7"
  },
  "license": "MIT"
}
