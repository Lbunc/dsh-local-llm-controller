{
  "name": "dsh-local-llm-controller",
  "version": "2.1.0",
  "description": "DSH plugin: start/stop a local llama.cpp llama-server from the settings → plugins page — two model slots (A/B) with per-slot model-file selection, eight editable launch-parameter groups (text/vision × fast/long × 2 slots), and one shared DSH provider carrying both slots' models with four thinking-effort levels.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "images",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "icon": "./images/icon.svg",
  "scripts": {
    "test": "node test/logic.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lbunc/dsh-local-llm-controller.git"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "cordis",
    "llama.cpp",
    "llama-server",
    "local-llm",
    "qwen"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.1"
  },
  "license": "MIT"
}
